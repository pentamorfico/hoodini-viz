{
  "name": "hoodini-viz",
  "version": "0.2.17",
  "description": "Interactive phylogenetic and genomic visualization library",
  "type": "module",
  "main": "./dist/hoodini-viz.umd.js",
  "module": "./dist/hoodini-viz.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hoodini-viz.js",
      "require": "./dist/hoodini-viz.umd.js"
    },
    "./style.css": "./dist/hoodini-viz.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pentamorfico/hoodini-viz.git"
  },
  "keywords": [
    "visualization",
    "genomics",
    "phylogenetic",
    "tree",
    "bioinformatics",
    "gene-neighborhood",
    "deckgl",
    "react"
  ],
  "author": "pentamorfico",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pentamorfico/hoodini-viz/issues"
  },
  "homepage": "https://github.com/pentamorfico/hoodini-viz#readme",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && BUILD_UMD=true vite build",
    "build:esm": "vite build",
    "build:umd": "BUILD_UMD=true vite build",
    "build:html": "vite build --config vite.config.html.ts",
    "build:template": "VITE_TEMPLATE_MODE=true vite build --config vite.config.html.ts",
    "build:all": "npm run build && npm run build:html",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deck.gl/core": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/react": "^9.1.14",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@luma.gl/effects": "^9.2.6",
    "@luma.gl/shadertools": "^9.2.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-table": "^8.21.3",
    "3dmol": "^2.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.1.14",
    "dicopal": "^0.8.1",
    "hyparquet": "^1.23.3",
    "hyparquet-compressors": "^1.1.1",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  }
}
